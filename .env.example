# 실제 키는 .env에만 넣고 절대 커밋하지 마세요.

# 사용할 LLM: gemini(기본, 무료 요금제 가능) 또는 anthropic
LLM_PROVIDER=gemini

# Gemini (Google AI Studio에서 발급)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Claude (LLM_PROVIDER=anthropic일 때만 필요)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

SYNC_WAIT_SEC=4.0
MOCK_LLM=0
MOCK_DELAY=0.2
LOG_LEVEL=INFO
